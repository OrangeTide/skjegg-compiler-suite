{ By-value small-struct FFI, the callee side (Phase 3): a Kobold `cdecl` routine that
  itself takes or returns a small record by value, so C can call it back across the C
  register ABI.  The routine reconstructs a by-value record parameter from the argument
  registers and scatters a record result into the return registers, mirroring what a C
  callee does.  Here the records are all-integer, so they ride general registers on every
  target (one INTEGER eightbyte on the 64-bit targets, two 4-byte words on rv32).  The glue
  (sfhost.c) receives each Kobold routine as a C function pointer and calls it with a
  by-value record, so a correct result proves the register reconstruction and return. }
program byval_callee;

type
  P2 = record x: integer; y: integer; end;        { 8 bytes: one INTEGER eightbyte / two words }
  P2Fn = function(p: P2): integer cdecl;
  MkP2Fn = function(a: integer; b: integer): P2 cdecl;

function CallP2(f: P2Fn): integer; cdecl; external name 'cb_call_p2';
function CallMkP2(f: MkP2Fn): integer; cdecl; external name 'cb_call_mkp2';

{ the Kobold callbacks: `cdecl`, so C's register ABI reaches them }
function SumP2(p: P2): integer; cdecl;
begin
  SumP2 := p.x + p.y;
end;

function MakeP2(a: integer; b: integer): P2; cdecl;
begin
  MakeP2.x := a;
  MakeP2.y := b;
end;

begin
  writeln('p2=', CallP2(SumP2));        { C passes a 3,4 record by value -> 7 }
  writeln('mkp2=', CallMkP2(MakeP2));   { Kobold returns a 10,20 record in registers, C sums -> 30 }
end.
