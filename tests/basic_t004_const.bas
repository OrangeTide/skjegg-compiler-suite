REM CONST and ENUM integer constants
CONST WIDTH = 320, HEIGHT = 240
CONST AREA = WIDTH * HEIGHT
ENUM SKY, GRASS, DIRT
ENUM RED = 20, GREEN, BLUE
ENUM
  ONE = 1
  TWO, THREE
  TEN = 10, ELEVEN
ENDENUM
DIM x AS INT
x = WIDTH + 1
PRINT "w="; WIDTH
PRINT "h="; HEIGHT
PRINT "area="; AREA
PRINT "enum="; SKY; GRASS; DIRT
PRINT "colors="; RED; GREEN; BLUE
PRINT "block="; ONE; TWO; THREE; TEN; ELEVEN
PRINT "x="; x
PRINT "expr="; (WIDTH DIV 2) + HEIGHT
END
