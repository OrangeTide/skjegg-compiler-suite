{ Real OS threads via std.osthreads: spawn workers on separate cores, join each for
  its result. A worker is handed to C with `@` as a function pointer. Shared-nothing:
  only integers cross the boundary. }
program parsum;
uses std.osthreads as _;

function work(n: integer): integer;   { sum 1..n, pure integer, no managed state }
var
  i, s: integer;
begin
  s := 0;
  for i := 1 to n do
    s := s + i;
  work := s;
end;

var
  a, b, c: integer;
begin
  if HardwareThreads >= 1 then
    writeln('cpus ok');
  a := Spawn(@work, 100);
  b := Spawn(@work, 1000);
  c := Spawn(@work, 10);
  writeln(Join(a));
  writeln(Join(b));
  writeln(Join(c));
end.
