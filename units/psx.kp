unit psx;
{ psx - the Kobold binding to the libpsx PlayStation SDK (milestone 6).

  A thin unit: it declares the libpsx C entry points as external cdecl and
  exposes them under Kobold names, adding no logic of its own. A game does
  `uses psx` and calls GpuInit, DrawRect, PadRead, Beep, and the fixed-point
  helpers. Kobold and libpsx share the toolkit stack calling convention, so the
  binding is a straight pass-through. }

interface

const
  { Digital controller buttons (1 = pressed), matching libpsx. }
  PadSelect   = $0001;
  PadStart    = $0008;
  PadUp       = $0010;
  PadRight    = $0020;
  PadDown     = $0040;
  PadLeft     = $0080;
  PadL1       = $0400;
  PadR1       = $0800;
  PadTriangle = $1000;
  PadCircle   = $2000;
  PadCross    = $4000;
  PadSquare   = $8000;

  FixOne = $00010000;        { 1.0 in 16.16 fixed point }

  { Voice pitch for a sample's recorded rate (see SpuPlay). }
  SpuPitch44100 = $1000;
  SpuPitch22050 = $0800;

  { Blend modes for DrawRectAlpha. }
  BlendHalf = 0;             { half back + half front }
  BlendAdd  = 1;             { back + front }
  BlendSub  = 2;             { back - front }
  BlendQuarter = 3;          { back + quarter front }

procedure GpuInit;
procedure IrqInit;
procedure SetBg(r, g, b: Integer);
procedure DrawRect(x, y, w, h, r, g, b: Integer);
procedure DrawRectAlpha(x, y, w, h, r, g, b, mode: Integer);
procedure Vsync;
procedure DisplaySwap;
function  PadRead: Integer;
function  PadId: Integer;
function  VblankCount: Integer;
procedure Beep;
function  Fmul(a, b: Integer): Integer;
function  Fsin(angle: Integer): Integer;
function  Fcos(angle: Integer): Integer;

{ Textures are reached by an integer handle from a C accessor that calls
  psx_tex_upload; see the handle note in psx.h. These draw by that handle. }
procedure TexDraw(tex, x, y: Integer);
procedure TexDrawUv(tex, x, y, u, v, w, h: Integer);
procedure TexRot(tex, cx, cy, angle, scale: Integer);

{ Sound. }
procedure SpuInit;
procedure SpuPlay(voice, addr, pitch, vol: Integer);
procedure SpuStop(voice: Integer);

{ CD-ROM: bring the drive up (mounting the disc as a filesystem is a C call,
  since it takes a path string). }
procedure CdInit;

{ 3D through the GTE, using the pointer-free helpers (libpsx/gte_easy.c) so the
  unit stays free of matrix and vertex arrays. Set the view once, build a
  rotation from three angles, project each vertex, and read its screen position
  and depth back. See examples/psx/cube.kp. }
procedure GteSetScreen(h, ofx, ofy: Integer);
procedure GteSetTrans(tx, ty, tz: Integer);
procedure GteRotXyz(ax, ay, az: Integer);
procedure GteProject(vx, vy, vz: Integer);
function  GteSx: Integer;
function  GteSy: Integer;
function  GteSz: Integer;

{ Ordering table: depth-sorted drawing. Clear it, add each face at its depth
  bucket, link it, then swap. Colours for OtAddGouraud4 are packed $RRGGBB. }
procedure OtClear;
procedure OtAddPoly4(x0, y0, x1, y1, x2, y2, x3, y3, r, g, b, z: Integer);
procedure OtAddGouraud4(x0, y0, c0, x1, y1, c1,
                        x2, y2, c2, x3, y3, c3, z: Integer);
procedure OtLink;

implementation

procedure psx_gpu_init; external cdecl;
procedure psx_irq_init; external cdecl;
procedure psx_set_bg(r, g, b: Integer); external cdecl;
procedure psx_draw_rect(x, y, w, h, r, g, b: Integer); external cdecl;
procedure psx_draw_rect_alpha(x, y, w, h, r, g, b, mode: Integer); external cdecl;
procedure psx_vsync; external cdecl;
procedure psx_display_swap; external cdecl;
function  psx_pad_read: Integer; external cdecl;
function  psx_pad_id: Integer; external cdecl;
function  psx_vblank_count: Integer; external cdecl;
procedure psx_beep; external cdecl;
function  psx_fmul(a, b: Integer): Integer; external cdecl;
function  psx_fsin(angle: Integer): Integer; external cdecl;
function  psx_fcos(angle: Integer): Integer; external cdecl;
procedure psx_tex_draw(tex, x, y: Integer); external cdecl;
procedure psx_tex_draw_uv(tex, x, y, u, v, w, h: Integer); external cdecl;
procedure psx_tex_rot(tex, cx, cy, angle, scale: Integer); external cdecl;
procedure psx_spu_init; external cdecl;
procedure psx_spu_play(voice, addr, pitch, vol: Integer); external cdecl;
procedure psx_spu_stop(voice: Integer); external cdecl;
procedure psx_cd_init; external cdecl;
procedure psx_gte_set_screen(h, ofx, ofy: Integer); external cdecl;
procedure psx_gte_set_trans(tx, ty, tz: Integer); external cdecl;
procedure psx_gte_rot_xyz(ax, ay, az: Integer); external cdecl;
procedure psx_gte_project(vx, vy, vz: Integer); external cdecl;
function  psx_gte_sx: Integer; external cdecl;
function  psx_gte_sy: Integer; external cdecl;
function  psx_gte_sz: Integer; external cdecl;
procedure psx_ot_clear; external cdecl;
procedure psx_ot_add_poly4(x0, y0, x1, y1, x2, y2, x3, y3,
                           r, g, b, z: Integer); external cdecl;
procedure psx_ot_add_gouraud4(x0, y0, c0, x1, y1, c1,
                              x2, y2, c2, x3, y3, c3, z: Integer); external cdecl;
procedure psx_ot_link; external cdecl;

procedure GpuInit;
begin
  psx_gpu_init;
end;

procedure IrqInit;
begin
  psx_irq_init;
end;

procedure SetBg(r, g, b: Integer);
begin
  psx_set_bg(r, g, b);
end;

procedure DrawRect(x, y, w, h, r, g, b: Integer);
begin
  psx_draw_rect(x, y, w, h, r, g, b);
end;

procedure Vsync;
begin
  psx_vsync;
end;

procedure DisplaySwap;
begin
  psx_display_swap;
end;

function PadRead: Integer;
begin
  PadRead := psx_pad_read;
end;

procedure Beep;
begin
  psx_beep;
end;

function Fmul(a, b: Integer): Integer;
begin
  Fmul := psx_fmul(a, b);
end;

function Fsin(angle: Integer): Integer;
begin
  Fsin := psx_fsin(angle);
end;

function Fcos(angle: Integer): Integer;
begin
  Fcos := psx_fcos(angle);
end;

procedure DrawRectAlpha(x, y, w, h, r, g, b, mode: Integer);
begin
  psx_draw_rect_alpha(x, y, w, h, r, g, b, mode);
end;

function PadId: Integer;
begin
  PadId := psx_pad_id;
end;

function VblankCount: Integer;
begin
  VblankCount := psx_vblank_count;
end;

procedure TexDraw(tex, x, y: Integer);
begin
  psx_tex_draw(tex, x, y);
end;

procedure TexDrawUv(tex, x, y, u, v, w, h: Integer);
begin
  psx_tex_draw_uv(tex, x, y, u, v, w, h);
end;

procedure TexRot(tex, cx, cy, angle, scale: Integer);
begin
  psx_tex_rot(tex, cx, cy, angle, scale);
end;

procedure SpuInit;
begin
  psx_spu_init;
end;

procedure SpuPlay(voice, addr, pitch, vol: Integer);
begin
  psx_spu_play(voice, addr, pitch, vol);
end;

procedure SpuStop(voice: Integer);
begin
  psx_spu_stop(voice);
end;

procedure CdInit;
begin
  psx_cd_init;
end;

procedure GteSetScreen(h, ofx, ofy: Integer);
begin
  psx_gte_set_screen(h, ofx, ofy);
end;

procedure GteSetTrans(tx, ty, tz: Integer);
begin
  psx_gte_set_trans(tx, ty, tz);
end;

procedure GteRotXyz(ax, ay, az: Integer);
begin
  psx_gte_rot_xyz(ax, ay, az);
end;

procedure GteProject(vx, vy, vz: Integer);
begin
  psx_gte_project(vx, vy, vz);
end;

function GteSx: Integer;
begin
  GteSx := psx_gte_sx;
end;

function GteSy: Integer;
begin
  GteSy := psx_gte_sy;
end;

function GteSz: Integer;
begin
  GteSz := psx_gte_sz;
end;

procedure OtClear;
begin
  psx_ot_clear;
end;

procedure OtAddPoly4(x0, y0, x1, y1, x2, y2, x3, y3, r, g, b, z: Integer);
begin
  psx_ot_add_poly4(x0, y0, x1, y1, x2, y2, x3, y3, r, g, b, z);
end;

procedure OtAddGouraud4(x0, y0, c0, x1, y1, c1,
                        x2, y2, c2, x3, y3, c3, z: Integer);
begin
  psx_ot_add_gouraud4(x0, y0, c0, x1, y1, c1, x2, y2, c2, x3, y3, c3, z);
end;

procedure OtLink;
begin
  psx_ot_link;
end;

end.
