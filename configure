#!/bin/sh
# configure : detect the optional external libraries that Kobold's optional units
# wrap, and write config.mk.  Each library found enables its unit in the build; a
# unit whose dependency is absent is silently skipped, so a plain `make` still
# builds the whole core toolchain with no external dependencies.  This is a small
# POSIX-sh probe, not autoconf: it keys off pkg-config (or a header/library probe
# for a single-header library).
#
# Usage: ./configure [--with-LIB=yes|no] ...
#   --with-<lib>=no    force a library's unit off even if present
#   --with-<lib>=yes   fail if the library is not found (CI pinning)
# Environment: PKG_CONFIG, CC may be overridden.
#
# config.mk is a generated file (git-ignored).  The Makefile reads it with
# `-include`, so building without running ./configure simply enables no optional
# units.  Re-run ./configure whenever the set of installed libraries changes.
set -u

PKG_CONFIG="${PKG_CONFIG:-pkg-config}"
CC="${CC:-cc}"
OUT=config.mk

with_sdl3=auto
with_libcurl=auto
with_raylib=auto

for arg in "$@"; do
    case $arg in
        --with-sdl3=*) with_sdl3=${arg#*=} ;;
        --with-libcurl=*) with_libcurl=${arg#*=} ;;
        --with-raylib=*) with_raylib=${arg#*=} ;;
        --help | -h)
            cat <<'EOF'
Usage: ./configure [options]
  --with-sdl3=yes|no     force the SDL3 unit on (fail if absent) or off
  --with-libcurl=yes|no  force the curl unit on (fail if absent) or off
  --with-raylib=yes|no   force the raylib unit on (fail if absent) or off
Environment:
  PKG_CONFIG            pkg-config program (default: pkg-config)
EOF
            exit 0
            ;;
        *)
            echo "configure: unknown option: $arg" >&2
            exit 2
            ;;
    esac
done

tmp="$OUT.tmp.$$"
trap 'rm -f "$tmp"' EXIT INT
: > "$tmp"
cat >> "$tmp" <<EOF
# Generated by ./configure.  Do not edit; re-run ./configure to regenerate.
# The Makefile reads this with -include; optional units key off the HAVE_* flags.
EOF

summary=""

# detect_pkg VAR pkg force : emit HAVE_VAR / VAR_CFLAGS / VAR_LIBS when pkg exists.
detect_pkg() {
    _var=$1
    _pkg=$2
    _force=$3
    if [ "$_force" = no ]; then
        summary="$summary
  $_pkg: off (--with-$_pkg=no)"
        return 0
    fi
    if "$PKG_CONFIG" --exists "$_pkg" 2>/dev/null; then
        _ver=$("$PKG_CONFIG" --modversion "$_pkg" 2>/dev/null)
        {
            echo "HAVE_$_var := 1"
            echo "${_var}_CFLAGS := $("$PKG_CONFIG" --cflags "$_pkg")"
            echo "${_var}_LIBS := $("$PKG_CONFIG" --libs "$_pkg")"
        } >> "$tmp"
        summary="$summary
  $_pkg: yes ($_ver)"
    else
        if [ "$_force" = yes ]; then
            echo "configure: --with-$_pkg=yes but $PKG_CONFIG cannot find '$_pkg'" >&2
            exit 1
        fi
        summary="$summary
  $_pkg: no"
    fi
}

# detect_raylib force : like detect_pkg, but raylib often installs with no .pc
# file (a from-source `make install` drops the static lib and headers under
# /usr/local). Try pkg-config first, then probe the header and the static link
# line directly. A static libraylib.a needs its transitive deps named here.
detect_raylib() {
    _force=$1
    if [ "$_force" = no ]; then
        summary="$summary
  raylib: off (--with-raylib=no)"
        return 0
    fi
    if "$PKG_CONFIG" --exists raylib 2>/dev/null; then
        _ver=$("$PKG_CONFIG" --modversion raylib 2>/dev/null)
        {
            echo "HAVE_RAYLIB := 1"
            echo "RAYLIB_CFLAGS := $("$PKG_CONFIG" --cflags raylib)"
            echo "RAYLIB_LIBS := $("$PKG_CONFIG" --libs raylib)"
        } >> "$tmp"
        summary="$summary
  raylib: yes ($_ver, pkg-config)"
        return 0
    fi
    # No .pc: probe the compiler. /usr/local is on the default search path for
    # most toolchains; add it explicitly in case it is not.
    _rl_cflags="-I/usr/local/include"
    _rl_libs="-L/usr/local/lib -lraylib -lGL -lm -lpthread -ldl -lrt -lX11"
    _probe="$OUT.probe.$$.c"
    _probe_bin="$OUT.probe.$$"
    cat > "$_probe" <<'PROBE'
#include "raylib.h"
int main(void) { SetTraceLogLevel(LOG_NONE); return 0; }
PROBE
    if $CC $_rl_cflags "$_probe" -o "$_probe_bin" $_rl_libs >/dev/null 2>&1; then
        {
            echo "HAVE_RAYLIB := 1"
            echo "RAYLIB_CFLAGS := $_rl_cflags"
            echo "RAYLIB_LIBS := $_rl_libs"
        } >> "$tmp"
        summary="$summary
  raylib: yes (probed, no pkg-config)"
    else
        if [ "$_force" = yes ]; then
            echo "configure: --with-raylib=yes but raylib's header and static library could not be linked" >&2
            rm -f "$_probe" "$_probe_bin"
            exit 1
        fi
        summary="$summary
  raylib: no"
    fi
    rm -f "$_probe" "$_probe_bin"
}

detect_pkg SDL3 sdl3 "$with_sdl3"
detect_pkg LIBCURL libcurl "$with_libcurl"
detect_raylib "$with_raylib"

mv "$tmp" "$OUT"
trap - EXIT INT
echo "configure: wrote $OUT"
echo "Optional libraries:$summary"
