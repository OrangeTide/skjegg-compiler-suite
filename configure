#!/bin/sh
# configure : detect the optional external libraries that Kobold's optional units
# wrap, and write config.mk.  Each library found enables its unit in the build; a
# unit whose dependency is absent is silently skipped, so a plain `make` still
# builds the whole core toolchain with no external dependencies.  This is a small
# POSIX-sh probe, not autoconf: it keys off pkg-config (or a header/library probe
# for a single-header library).
#
# Usage: ./configure [--with-LIB=yes|no] ...
#   --with-<lib>=no    force a library's unit off even if present
#   --with-<lib>=yes   fail if the library is not found (CI pinning)
# Environment: PKG_CONFIG, CC may be overridden.
#
# config.mk is a generated file (git-ignored).  The Makefile reads it with
# `-include`, so building without running ./configure simply enables no optional
# units.  Re-run ./configure whenever the set of installed libraries changes.
set -u

PKG_CONFIG="${PKG_CONFIG:-pkg-config}"
OUT=config.mk

with_sdl3=auto

for arg in "$@"; do
    case $arg in
        --with-sdl3=*) with_sdl3=${arg#*=} ;;
        --help | -h)
            cat <<'EOF'
Usage: ./configure [options]
  --with-sdl3=yes|no    force the SDL3 unit on (fail if absent) or off
Environment:
  PKG_CONFIG            pkg-config program (default: pkg-config)
EOF
            exit 0
            ;;
        *)
            echo "configure: unknown option: $arg" >&2
            exit 2
            ;;
    esac
done

tmp="$OUT.tmp.$$"
trap 'rm -f "$tmp"' EXIT INT
: > "$tmp"
cat >> "$tmp" <<EOF
# Generated by ./configure.  Do not edit; re-run ./configure to regenerate.
# The Makefile reads this with -include; optional units key off the HAVE_* flags.
EOF

summary=""

# detect_pkg VAR pkg force : emit HAVE_VAR / VAR_CFLAGS / VAR_LIBS when pkg exists.
detect_pkg() {
    _var=$1
    _pkg=$2
    _force=$3
    if [ "$_force" = no ]; then
        summary="$summary
  $_pkg: off (--with-$_pkg=no)"
        return 0
    fi
    if "$PKG_CONFIG" --exists "$_pkg" 2>/dev/null; then
        _ver=$("$PKG_CONFIG" --modversion "$_pkg" 2>/dev/null)
        {
            echo "HAVE_$_var := 1"
            echo "${_var}_CFLAGS := $("$PKG_CONFIG" --cflags "$_pkg")"
            echo "${_var}_LIBS := $("$PKG_CONFIG" --libs "$_pkg")"
        } >> "$tmp"
        summary="$summary
  $_pkg: yes ($_ver)"
    else
        if [ "$_force" = yes ]; then
            echo "configure: --with-$_pkg=yes but $PKG_CONFIG cannot find '$_pkg'" >&2
            exit 1
        fi
        summary="$summary
  $_pkg: no"
    fi
}

detect_pkg SDL3 sdl3 "$with_sdl3"

mv "$tmp" "$OUT"
trap - EXIT INT
echo "configure: wrote $OUT"
echo "Optional libraries:$summary"
